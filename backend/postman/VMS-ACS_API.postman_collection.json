          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Perimeter still - intruder",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "The minimum viable upload: just `file` plus `title`. Pick a real file for the `file` part in the Body tab.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recordings",
              "host": [
                "{{baseUrl}}"
