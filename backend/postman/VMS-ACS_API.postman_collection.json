{
  "info": {
    "_postman_id": "b7f3c2a1-9d4e-4c8b-a1f2-5e6d7c8b9a01",
    "name": "VMS-ACS API (MongoDB)",
    "description": "Visitor Management, Access Control & CCTV Evidence API.\n\nHOW TO USE\n1. Set the `baseUrl` variable to your running API (default http://localhost:8080).\n2. Run \"Auth > Login (admin)\" FIRST - its test script captures the JWT into `token`.\n3. Every other request sends `Authorization: Bearer {{token}}` via collection-level auth.\n\nResponses use the envelope `{ success, data, meta }` or `{ success:false, error:{ code, message } }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Error responses use HTTP 4xx with `{ success:false, error:{...} }`, so success",
          "// must be read from the body rather than assumed from the status code.",
          "pm.test('Response is JSON', () => { pm.response.to.be.json; });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "zoneId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cameraId",
      "value": "",
      "type": "string"
    },
    {
      "key": "visitorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "visitId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "alertId",
      "value": "",
      "type": "string"
    }
  ],
