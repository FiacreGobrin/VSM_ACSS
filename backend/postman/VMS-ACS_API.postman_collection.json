    {
      "name": "05 - CCTV Evidence Upload",
      "item": [
        {
          "name": "List Recordings",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Filters: ?mediaKind=video|image, ?cameraId=<uuid>. Pagination lands in `meta`.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recordings?limit=24&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recordings"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "24"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Upload Recording",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "title",
                  "value": "Main Gate - tailgating 22:14",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Two badges scanned, three persons through",
                  "type": "text"
                },
                {
                  "key": "cameraId",
                  "value": "{{cameraId}}",
                  "type": "text"
                },
                {
                  "key": "retentionDays",
                  "value": "30",
                  "type": "text"
                }
              ]
            },
            "description": "Body tab: set `file` to type **File** (not Text), then pick an .mp4/.webm/.mov/.jpg/.png.\nadmin + operator only - a guard receives 403.\nThe server verifies the file by MAGIC BYTES, so a renamed executable is rejected with 415 `unsupported_media_type` no matter what Content-Type Postman sends.\nSet cameraId to {{cameraId}} to attribute the clip to a registered camera.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recordings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recordings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = body.data.id;",
                  "if (id) {",
                  "  pm.collectionVariables.set('recordingId', String(id));",
                  "  console.log('recordingId =', id);",
                  "}"
                ]
              }
            }
          ]
        },
