        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Uptime plus a live MongoDB round-trip. Use this to prove the database is genuinely reachable, not merely that the process started.",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "description": "Run this FIRST. Seeded credentials are admin / AdminPass123!.",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Login returns a token', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.success && body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  console.log('Token captured:', body.data.token.slice(0, 24) + '...');",
                  "} else {",
                  "  console.error('Login failed:', JSON.stringify(body));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (guard - RBAC checks)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"guard_john\",\n  \"password\": \"GuardPass123!\"\n}"
            },
            "description": "Logs in as a guard to confirm 403s on privileged routes. Overwrites `token`, so re-run the admin login afterwards.",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = body.data.token;",
                  "if (id) {",
                  "  pm.collectionVariables.set('guardToken', String(id));",
                  "  console.log('guardToken =', id);",
                  "}"
                ]
              }
            }
          ]
        },
