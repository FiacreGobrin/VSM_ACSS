        {
          "name": "Stream Recording",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Streams the bytes with HTTP range support, so seeking works. Postman previews media inline.\nFor a specific range, add the header `Range: bytes=0-1023`.\nAppend `?download=1` to force a download instead of inline playback.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/recordings/{{recordingId}}/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "recordings",
                "{{recordingId}}",
                "stream"
              ]
            }
          }
        },
        {
          "name": "Download Recording",
          "request": {
            "method": "GET",
