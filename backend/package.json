{
  "name": "cctv-visitor-backend",
  "version": "1.0.0",
  "description": "Robust Backend for Visitor Management, Authorization, and CCTV Camera Identification with Neon PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/scripts/migrate.js",
    "db:check": "node src/scripts/db-check.js",
    "db:seed": "node src/scripts/seed.js",
    "test": "node --test"
  },
  "keywords": [
    "neon",
    "postgresql",
    "visitor-management",
    "cctv",
    "identification",
    "access-control"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1"
  }
}
