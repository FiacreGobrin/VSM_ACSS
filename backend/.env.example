# Server Port & Environment
PORT=8080
NODE_ENV=development

# ------------------------------------------------------------------------------
# NEON POSTGRESQL DATABASE CONNECTION
# ------------------------------------------------------------------------------
# 1. Sign up or log into https://neon.tech
# 2. Create a project (e.g. "visitor-cctv-system")
# 3. From your dashboard, copy your Connection Details:
#    - Direct endpoint (recommended for backend & migrations):
#      postgresql://[username]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
#    - Pooled endpoint (PgBouncer) — use this for production traffic:
#      postgresql://[username]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
#
#    IMPORTANT: if your username contains "@" (for example an email address),
#    URL-encode it as %40 — otherwise the connection string is unparseable and
#    the server will refuse to start.
#
#      postgresql://my%40account.com:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USERNAME:PASSWORD@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=change_me_to_a_secure_random_key_for_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Database Pool Tuning (Optimized for Neon Serverless)
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# CCTV EVIDENCE UPLOADS
# ------------------------------------------------------------------------------
# Uploaded clips and reference stills are written to this directory, which must
# live on a volume with room for the whole retention window. The path is
# resolved relative to the backend/ working directory.
#   Defaults: UPLOAD_DIR=uploads
#            UPLOAD_MAX_VIDEO_BYTES=524288000   (500 MB)
#            UPLOAD_MAX_IMAGE_BYTES=15728640    (15 MB)
#            UPLOAD_MAX_FILES=10
# Note: UPLOAD_MAX_VIDEO_BYTES is enforced by multer while the request is still
# streaming, so it also caps the API process's peak memory use per upload.
UPLOAD_DIR=uploads
UPLOAD_MAX_VIDEO_BYTES=524288000
UPLOAD_MAX_IMAGE_BYTES=15728640
UPLOAD_MAX_FILES=10
